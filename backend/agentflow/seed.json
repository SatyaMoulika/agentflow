{
  "workflows": [
    {
      "id": "wf_invoice",
      "name": "Invoice Approval Automation",
      "description": "From inbox to approval. Extract invoice data and keep your payments moving.",
      "status": "active",
      "icon": "invoice",
      "nodes": [
        {
          "id": "invoice_trigger",
          "type": "manual",
          "label": "Invoice received",
          "position": {
            "x": 0,
            "y": 150
          },
          "config": {}
        },
        {
          "id": "invoice_extract",
          "type": "extract",
          "label": "Extract invoice details",
          "position": {
            "x": 300,
            "y": 150
          },
          "config": {
            "model": "gpt-4.1-mini",
            "prompt": "Extract invoice number, vendor, amount, and currency.",
            "temperature": 0,
            "maxTokens": 2048,
            "outputSchema": "{\"invoice_number\":\"string\",\"amount\":\"number\",\"vendor\":\"string\"}"
          }
        },
        {
          "id": "invoice_validate",
          "type": "transform",
          "label": "Validate invoice",
          "position": {
            "x": 600,
            "y": 150
          },
          "config": {
            "expression": "input",
            "description": "Validate required fields and normalize the result."
          }
        },
        {
          "id": "invoice_condition",
          "type": "condition",
          "label": "Amount exceeds ₹50,000?",
          "position": {
            "x": 900,
            "y": 150
          },
          "config": {
            "variable": "amount",
            "operator": "greater_than",
            "value": "50000"
          }
        },
        {
          "id": "invoice_approve",
          "type": "approval",
          "label": "Finance approval",
          "position": {
            "x": 1200,
            "y": 30
          },
          "config": {
            "title": "Review invoice payment",
            "approver": "Moulika",
            "description": "Review the extracted invoice before saving.",
            "expiration": "24 hours"
          }
        },
        {
          "id": "invoice_store",
          "type": "http",
          "label": "Save invoice",
          "position": {
            "x": 1500,
            "y": 150
          },
          "config": {
            "url": "https://example.com/api/results",
            "method": "POST",
            "headers": "{\"Content-Type\":\"application/json\"}",
            "body": "{{ input }}",
            "timeout": 30,
            "retries": 2
          }
        },
        {
          "id": "invoice_end",
          "type": "end",
          "label": "Workflow complete",
          "position": {
            "x": 1800,
            "y": 150
          },
          "config": {}
        },
        {
          "id": "invoice_reject",
          "type": "end",
          "label": "Payment declined",
          "position": {
            "x": 1500,
            "y": 380
          },
          "config": {}
        }
      ],
      "edges": [
        {
          "id": "invoice_trigger-invoice_extract",
          "source": "invoice_trigger",
          "target": "invoice_extract"
        },
        {
          "id": "invoice_extract-invoice_validate",
          "source": "invoice_extract",
          "target": "invoice_validate"
        },
        {
          "id": "invoice_validate-invoice_condition",
          "source": "invoice_validate",
          "target": "invoice_condition"
        },
        {
          "id": "invoice_condition-invoice_approve",
          "source": "invoice_condition",
          "target": "invoice_approve",
          "sourceHandle": "true"
        },
        {
          "id": "invoice_condition-invoice_store",
          "source": "invoice_condition",
          "target": "invoice_store",
          "sourceHandle": "false"
        },
        {
          "id": "invoice_approve-invoice_store",
          "source": "invoice_approve",
          "target": "invoice_store",
          "sourceHandle": "approved"
        },
        {
          "id": "invoice_approve-invoice_reject",
          "source": "invoice_approve",
          "target": "invoice_reject",
          "sourceHandle": "rejected"
        },
        {
          "id": "invoice_store-invoice_end",
          "source": "invoice_store",
          "target": "invoice_end"
        }
      ],
      "version": 1,
      "createdAt": "2026-09-15T05:25:33.520Z",
      "updatedAt": "2026-10-30T04:49:33.520Z",
      "totalRuns": 0,
      "successRate": 0
