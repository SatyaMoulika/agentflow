# Optional local configuration. Copy to backend/.env; keep actual secrets private.
# Process environment variables override this file. The five values below are defaults.
AGENTFLOW_APP_NAME="AgentFlow API"
AGENTFLOW_ENVIRONMENT=development
AGENTFLOW_DEBUG=false
AGENTFLOW_DOCS_ENABLED=true
AGENTFLOW_LOG_LEVEL=INFO

# Optional PostgreSQL. No URL means data endpoints return safe 503 errors.
# Start the local Compose postgres service before uncommenting. Local credentials only.
# AGENTFLOW_DATABASE_URL=postgresql+psycopg://agentflow:agentflow_local@127.0.0.1:15432/agentflow

# Optional worker transport, enabled only when starting the worker/probe separately.
# Local development only. Production requires rediss:// with TLS and a password.
# AGENTFLOW_REDIS_URL=redis://127.0.0.1:16379/0
# Optional Groq connection; keep the real key in backend/.env only.
# GROQ_API_KEY=your_groq_key
# AGENTFLOW_GROQ_MODEL=openai/gpt-oss-120b
# AGENTFLOW_GROQ_TIMEOUT_SECONDS=45
# AGENTFLOW_WORKER_QUEUE=agentflow.transport
# Opt in only after migrating and starting the worker plus outbox dispatcher.
# Pure graphs return 202; Groq graphs remain synchronous. No broker call in the API.
# AGENTFLOW_BACKGROUND_EXECUTION_ENABLED=false
# AGENTFLOW_WORKER_LEASE_SECONDS=30
# AGENTFLOW_WORKER_REDELIVERY_SECONDS=30
# Retry delay policy is saved when the API creates a new background run.
# AGENTFLOW_WORKER_RETRY_BASE_SECONDS=5
# AGENTFLOW_WORKER_RETRY_MAX_SECONDS=60
# Unset conflicting CELERY_BROKER_URL, CELERY_BROKER_READ_URL,
# CELERY_BROKER_WRITE_URL, CELERY_RESULT_BACKEND, CELERY_LOADER and
# CELERY_CONFIG_MODULE; use AgentFlow settings for this worker.

# Login/access JWTs require a private random signing key (at least 32 UTF-8 bytes).
# Generate locally: uv run --locked python -c 'import secrets; print(secrets.token_hex(32))'
# Add AGENTFLOW_JWT_SECRET_KEY=<generated value> to your private .env. No default key.
# AGENTFLOW_JWT_ISSUER=agentflow
# AGENTFLOW_JWT_AUDIENCE=agentflow-api
# AGENTFLOW_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh sessions: absolute lifetime (default seven days, permitted 300–2592000s).
# AGENTFLOW_REFRESH_TOKEN_TTL_SECONDS=604800
# Secure cookies are the default. For LOCAL HTTP only, explicitly use false.
# Production refuses false. Restart after editing configuration.
# AGENTFLOW_REFRESH_COOKIE_SECURE=false
# Exact browser/API origins, JSON array; no paths/wildcards. No CORS middleware yet.
# AGENTFLOW_AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://localhost:5173"]
# Login/refresh require Origin plus X-AgentFlow-Client: web.
# Refresh additionally requires X-AgentFlow-CSRF matching its readable CSRF cookie.
